{
	// Assets only: no Worker script. Deployed with site/deploy.sh.
	"name": "boxrunner-site",
	"routes": [{ "pattern": "boxrunner.zabcik.me", "custom_domain": true }],
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		// /docs/config redirects to /docs/config/, which serves docs/config/index.html.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
