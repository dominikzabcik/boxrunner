[2.910879, "o", "==> download boxrunner 0.2.0 for linux/arm64\r\r\n"]
[3.582835, "o", "==> checksum ok\r\r\n==> skipped the build attestation check (needs gh, signed in)\r\r\n"]
[3.692078, "o", "==> install Docker (docker.io) and start it\r\r\n"]
[100.03043, "o", "==> write /etc/systemd/system/boxrunner_idle.slice (0644)\r\r\n==> write /etc/systemd/system/boxrunner.service (0644)\r\r\n==> write /etc/boxrunner/token (0600)\r\r\n==> reload systemd\r\r\n"]
[100.355431, "o", "==> create the Docker network boxrunner on bridge boxrunner0\r\r\n"]
[100.661392, "o", "==> apply the firewall rules for boxrunner0\r\r\n"]
[100.684832, "o", "==> build the job image boxrunner/runner:local\r\r\n"]
[452.125851, "o", "==> enable and start boxrunner.service\r\r\n"]
[452.713153, "o", "Done in 9 steps. Check the box with: sudo boxrunner doctor\r\r\n"]
