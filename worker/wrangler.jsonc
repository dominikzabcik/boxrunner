{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "boxrunner",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	// The Worker holds the App key; one address is enough.
	"preview_urls": false,
	"observability": { "enabled": true },
	"vars": {
		// The runner classes the Worker serves, comma-separated. Each becomes a
		// scale set's name and its only label, so a workflow picks one with runs-on.
		"CLASSES": "boxrunner,boxrunner-light",
		// Optional: only these repositories (owner/name, comma-separated) out of
		// the private ones the App is installed on. Empty serves them all.
		"REPOS": "",
		// Optional: GitHub logins (comma-separated) that may open the dashboard
		// besides the App's owner.
		"ADMINS": "",
		// Optional: minutes without a heartbeat after which the Worker sets the
		// BOXRUNNER_DOWN variable in every served repository, so workflows that
		// read it run on GitHub's runners (docs/fallback.md). Needs the App's
		// Variables permission. Empty turns fallback off.
		"FALLBACK_MINUTES": "",
		// Optional: minutes without a heartbeat after which the Worker posts to
		// the ALERT_WEBHOOK secret (docs/alerts.md). Empty means 10. With
		// fallback on, FALLBACK_MINUTES decides instead.
		"ALERT_MINUTES": ""
	},
	"secrets": {
		"required": ["SETUP_SECRET"]
	},
	"durable_objects": {
		"bindings": [{ "name": "BOX", "class_name": "BoxObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoxObject"] }]
}
